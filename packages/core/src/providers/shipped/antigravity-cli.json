{
  "id": "antigravity-cli",
  "schemaVersion": 1,
  "name": "Antigravity CLI",
  "shortName": "agy",
  "protocol": "agy",
  "roots": ["{home}/.gemini/antigravity-cli"],
  "profiles": {
    "windows": {
      "detect": {},
      "executable": [
        { "kind": "path", "value": "agy" },
        { "kind": "file", "value": "{home}/AppData/Local/agy/bin/agy.exe" }
      ],
      "update": { "args": ["update"] },
      "isolation": {},
      "env": { "BROWSER": "{browserNoop}", "NO_COLOR": "1", "AGY_CLI_DISABLE_AUTO_UPDATE": "true" },
      "close": { "processes": [] }
    },
    "linux": {
      "detect": {},
      "executable": [{ "kind": "path", "value": "agy" }],
      "update": { "args": ["update"] },
      "isolation": {},
      "env": { "BROWSER": "{browserNoop}", "NO_COLOR": "1", "AGY_CLI_DISABLE_AUTO_UPDATE": "true" },
      "close": { "processes": [] }
    },
    "macos": {
      "detect": {},
      "executable": [{ "kind": "path", "value": "agy" }],
      "update": { "args": ["update"] },
      "isolation": {},
      "env": { "BROWSER": "{browserNoop}", "NO_COLOR": "1", "AGY_CLI_DISABLE_AUTO_UPDATE": "true" },
      "close": { "processes": [] }
    }
  },
  "auth": { "kind": "none" },
  "models": [{ "id": "default", "name": "Antigravity CLI default", "default": true }],
  "capabilities": {
    "approvals": false,
    "hooks": false,
    "checkpoint": false,
    "images": false,
    "planMode": true,
    "resume": true
  }
}
