{
  "id": "codex",
  "schemaVersion": 1,
  "name": "Codex",
  "shortName": "Codex",
  "protocol": "codex-appserver",
  "roots": ["{home}/.codex", "{isolationDir}"],
  "profiles": {
    "windows": {
      "detect": {},
      "update": { "args": ["update"], "latestNpm": "@openai/codex" },
      "executable": [
        { "kind": "file", "value": "{agentsDir}/codex-x86_64-pc-windows-msvc.exe" },
        {
          "kind": "file",
          "value": "{npmRoot}/@openai/codex/node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc/bin/codex.exe",
          "updateEnv": { "CODEX_MANAGED_BY_NPM": "1" }
        },
        {
          "kind": "file",
          "value": "{npmRoot}/@openai/codex/node_modules/@openai/codex-win32-arm64/vendor/aarch64-pc-windows-msvc/bin/codex.exe",
          "updateEnv": { "CODEX_MANAGED_BY_NPM": "1" }
        },
        { "kind": "path", "value": "codex" }
      ],
      "install": {
        "arch": "x64",
        "version": "0.163.0",
        "url": "https://github.com/openai/codex/releases/download/rust-v0.163.0/codex-x86_64-pc-windows-msvc.exe.zip",
        "sha256": "dabdb4d16aaf10fea40b74811c96efddcd9138f122163b69ed604fcb3eb704c3",
        "archiveBytes": 167080091,
        "files": [
          { "path": "codex-x86_64-pc-windows-msvc.exe", "bytes": 341270320 },
          { "path": "codex-code-mode-host.exe", "bytes": 74921264 },
          { "path": "codex-command-runner.exe", "bytes": 8217904 },
          { "path": "codex-windows-sandbox-setup.exe", "bytes": 17700144 }
        ]
      },
      "launch": { "args": ["app-server"] },
      "isolation": { "CODEX_HOME": "{isolationDir}" },
      "close": { "processes": ["codex.exe", "codex-x86_64-pc-windows-msvc.exe"] }
    },
    "linux": {
      "detect": {},
      "update": { "args": ["update"], "latestNpm": "@openai/codex" },
      "executable": [{ "kind": "path", "value": "codex" }],
      "launch": { "args": ["app-server"] },
      "isolation": { "CODEX_HOME": "{isolationDir}" },
      "close": { "processes": ["codex"] }
    },
    "macos": {
      "detect": {},
      "update": { "args": ["update"], "latestNpm": "@openai/codex" },
      "executable": [{ "kind": "path", "value": "codex" }],
      "launch": { "args": ["app-server"] },
      "isolation": { "CODEX_HOME": "{isolationDir}" },
      "close": { "processes": ["codex"] }
    }
  },
  "auth": { "kind": "oauth-cli", "session": ["auth.json"] },
  "login": { "command": ["codex", "login", "--device-auth"] },
  "shared": [
    {
      "variable": "CODEX_HOME",
      "paths": ["config.toml", "hooks.json", "AGENTS.md", "skills", "rules", "prompts", "plugins"],
      "retarget": { "config.toml": ["hooks.json", "config.toml"] }
    }
  ],
  "hookSources": [
    { "variable": "CODEX_HOME", "path": "hooks.json", "format": "events" }
  ],
  "models": [{ "id": "default", "name": "Codex default", "default": true }],
  "capabilities": {
    "approvals": true,
    "hooks": true,
    "checkpoint": false,
    "images": true,
    "planMode": true,
    "resume": true
  }
}
