{
  "id": "codex",
  "schemaVersion": 1,
  "name": "Codex",
  "shortName": "Codex",
  "protocol": "codex-appserver",
  "roots": ["{home}/.codex", "{isolationDir}"],
  "profiles": {
    "windows": {
      "detect": {},
      "update": { "args": ["update"], "latestNpm": "@openai/codex" },
      "executable": [
        { "kind": "file", "value": "{agentsDir}/codex-x86_64-pc-windows-msvc.exe" },
        {
          "kind": "file",
          "value": "{npmRoot}/@openai/codex/node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc/bin/codex.exe",
          "updateEnv": { "CODEX_MANAGED_BY_NPM": "1" }
        },
        {
          "kind": "file",
          "value": "{npmRoot}/@openai/codex/node_modules/@openai/codex-win32-arm64/vendor/aarch64-pc-windows-msvc/bin/codex.exe",
          "updateEnv": { "CODEX_MANAGED_BY_NPM": "1" }
        },
        { "kind": "path", "value": "codex" }
      ],
      "install": {
        "arch": "x64",
        "version": "0.155.1",
        "url": "https://github.com/openai/codex/releases/download/rust-v0.155.1/codex-x86_64-pc-windows-msvc.exe.zip",
        "sha256": "ce2269bdb7dfc06bb85c014c9c4e6b1601ffa0d646a2ae5b9b8cc8a427ef61fb",
        "archiveBytes": 107573195,
        "files": [
          { "path": "codex-x86_64-pc-windows-msvc.exe", "bytes": 307108144 },
          { "path": "codex-command-runner.exe", "bytes": 8217904 },
          { "path": "codex-windows-sandbox-setup.exe", "bytes": 15498544 }
        ]
      },
      "launch": { "args": ["app-server"] },
      "isolation": { "CODEX_HOME": "{isolationDir}" },
      "close": { "processes": ["codex.exe", "codex-x86_64-pc-windows-msvc.exe"] }
    },
    "linux": {
      "detect": {},
      "update": { "args": ["update"], "latestNpm": "@openai/codex" },
      "executable": [{ "kind": "path", "value": "codex" }],
      "launch": { "args": ["app-server"] },
      "isolation": { "CODEX_HOME": "{isolationDir}" },
      "close": { "processes": ["codex"] }
    },
    "macos": {
      "detect": {},
      "update": { "args": ["update"], "latestNpm": "@openai/codex" },
      "executable": [{ "kind": "path", "value": "codex" }],
      "launch": { "args": ["app-server"] },
      "isolation": { "CODEX_HOME": "{isolationDir}" },
      "close": { "processes": ["codex"] }
    }
  },
  "auth": { "kind": "oauth-cli", "session": ["auth.json"] },
  "login": { "command": ["codex", "login", "--device-auth"] },
  "models": [{ "id": "default", "name": "Codex default", "default": true }],
  "capabilities": {
    "approvals": true,
    "hooks": false,
    "checkpoint": false,
    "images": true,
    "planMode": true,
    "resume": true
  }
}
