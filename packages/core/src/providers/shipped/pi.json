{
  "id": "pi",
  "schemaVersion": 1,
  "name": "pi",
  "shortName": "pi",
  "protocol": "pi",
  "roots": ["{home}/.pi", "{isolationDir}"],
  "profiles": {
    "windows": {
      "detect": {},
      "executable": [
        { "kind": "npm", "value": "@earendil-works/pi-coding-agent#pi" },
        { "kind": "npm", "value": "@mariozechner/pi-coding-agent#pi" }
      ],
      "launch": { "args": ["--mode", "rpc"] },
      "isolation": { "PI_CODING_AGENT_DIR": "{isolationDir}" },
      "close": { "processes": [] }
    },
    "linux": {
      "detect": {},
      "executable": [
        { "kind": "path", "value": "pi" },
        { "kind": "npm", "value": "@earendil-works/pi-coding-agent#pi" },
        { "kind": "npm", "value": "@mariozechner/pi-coding-agent#pi" }
      ],
      "launch": { "args": ["--mode", "rpc"] },
      "isolation": { "PI_CODING_AGENT_DIR": "{isolationDir}" },
      "close": { "processes": [] }
    },
    "macos": {
      "detect": {},
      "executable": [
        { "kind": "path", "value": "pi" },
        { "kind": "npm", "value": "@earendil-works/pi-coding-agent#pi" },
        { "kind": "npm", "value": "@mariozechner/pi-coding-agent#pi" }
      ],
      "launch": { "args": ["--mode", "rpc"] },
      "isolation": { "PI_CODING_AGENT_DIR": "{isolationDir}" },
      "close": { "processes": [] }
    }
  },
  "auth": { "kind": "oauth-cli", "session": ["auth.json"] },
  "models": [{ "id": "default", "name": "pi default", "default": true }],
  "capabilities": {
    "approvals": false,
    "hooks": false,
    "checkpoint": false,
    "images": true,
    "planMode": false,
    "resume": true
  }
}
