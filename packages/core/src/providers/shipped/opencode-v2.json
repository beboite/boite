{
  "id": "opencode-v2",
  "schemaVersion": 1,
  "name": "OpenCode 2",
  "shortName": "OpenCode 2",
  "protocol": "acp",
  "experimental": true,
  "roots": ["{home}/.local/share/opencode-v2", "{home}/.config/opencode-v2", "{home}/.local/state/opencode-v2", "{home}/.cache/opencode-v2", "{isolationDir}"],
  "env": { "XDG_DATA_HOME": "{home}/.local/share/opencode-v2", "XDG_CONFIG_HOME": "{home}/.config/opencode-v2", "XDG_STATE_HOME": "{home}/.local/state/opencode-v2", "XDG_CACHE_HOME": "{home}/.cache/opencode-v2", "OPENCODE_CONFIG_CONTENT": "{\"permissions\":[{\"action\":\"subagent\",\"resource\":\"*\",\"effect\":\"deny\"}]}" },
  "profiles": {
    "windows": {
      "detect": {},
      "update": { "args": ["upgrade"], "latestNpm": "@opencode/cli" },
      "executable": [
        { "kind": "file", "value": "{agentsDir}/package/bin/opencode.exe" },
        { "kind": "file", "value": "{npmRoot}/@opencode/cli/bin/opencode.exe" },
        { "kind": "path", "value": "opencode2" },
        { "kind": "path", "value": "opencode", "major": 2 },
        { "kind": "file", "value": "{home}/.opencode/bin/opencode.exe", "major": 2 }
      ],
      "install": {
        "arch": "x64",
        "version": "2.2.0",
        "format": "tgz",
        "url": "https://registry.npmjs.org/@opencode/cli-windows-x64/-/cli-windows-x64-2.2.0.tgz",
        "sha256": "e5b387b4d2af88ffbd689ac84d35b71462072651f7529ab0f36721e35ba859bf",
        "archiveBytes": 118650212,
        "files": [{ "path": "package/bin/opencode.exe", "bytes": 253303688 }]
      },
      "launch": { "args": ["acp"] },
      "isolation": { "XDG_DATA_HOME": "{isolationDir}", "XDG_CONFIG_HOME": "{isolationDir}", "XDG_STATE_HOME": "{isolationDir}/state" },
      "close": { "processes": ["opencode.exe"] }
    },
    "linux": {
      "detect": {},
      "update": { "args": ["upgrade"], "latestNpm": "@opencode/cli" },
      "executable": [
        { "kind": "path", "value": "opencode2" },
        { "kind": "file", "value": "{home}/.opencode/bin/opencode2" },
        { "kind": "file", "value": "{npmRoot}/@opencode/cli/bin/opencode.exe" },
        { "kind": "path", "value": "opencode", "major": 2 },
        { "kind": "file", "value": "{home}/.opencode/bin/opencode", "major": 2 }
      ],
      "launch": { "args": ["acp"] },
      "isolation": { "XDG_DATA_HOME": "{isolationDir}", "XDG_CONFIG_HOME": "{isolationDir}", "XDG_STATE_HOME": "{isolationDir}/state" },
      "close": { "processes": ["opencode.exe", "opencode2"] }
    },
    "macos": {
      "detect": {},
      "update": { "args": ["upgrade"], "latestNpm": "@opencode/cli" },
      "executable": [
        { "kind": "path", "value": "opencode2" },
        { "kind": "file", "value": "{home}/.opencode/bin/opencode2" },
        { "kind": "file", "value": "{npmRoot}/@opencode/cli/bin/opencode.exe" },
        { "kind": "path", "value": "opencode", "major": 2 },
        { "kind": "file", "value": "{home}/.opencode/bin/opencode", "major": 2 }
      ],
      "launch": { "args": ["acp"] },
      "isolation": { "XDG_DATA_HOME": "{isolationDir}", "XDG_CONFIG_HOME": "{isolationDir}", "XDG_STATE_HOME": "{isolationDir}/state" },
      "close": { "processes": ["opencode.exe", "opencode2"] }
    }
  },
  "auth": { "kind": "oauth-cli", "sqlite": { "file": "opencode/opencode.db", "tables": ["credential", "account", "control_account"] } },
  "login": { "command": ["opencode2", "auth", "login", "--standalone"], "terminal": true },
  "shared": [
    {
      "variable": "XDG_CONFIG_HOME",
      "paths": ["opencode/opencode.json", "opencode/opencode.jsonc", "opencode/cli.json", "opencode/AGENTS.md", "opencode/package.json", "opencode/plugins", "opencode/plugin", "opencode/agents", "opencode/agent", "opencode/commands", "opencode/command", "opencode/skills", "opencode/node_modules"]
    }
  ],
  "hookSources": [
    { "variable": "XDG_CONFIG_HOME", "path": "opencode/plugins", "format": "modules" }
  ],
  "models": [{ "id": "default", "name": "OpenCode default", "default": true }],
  "capabilities": {
    "approvals": true,
    "hooks": true,
    "checkpoint": false,
    "images": true,
    "planMode": true,
    "resume": true
  }
}
