{
  "id": "gemini",
  "schemaVersion": 1,
  "name": "Gemini CLI",
  "shortName": "Gemini",
  "protocol": "acp",
  "roots": ["{home}/.gemini", "{isolationDir}"],
  "profiles": {
    "windows": {
      "detect": { "file": "{appdata}/npm/node_modules/@google/gemini-cli/bundle/gemini.js" },
      "executable": [{ "kind": "path", "value": "node" }],
      "launch": {
        "args": ["{appdata}/npm/node_modules/@google/gemini-cli/bundle/gemini.js", "--experimental-acp"]
      },
      "isolation": { "GEMINI_CLI_HOME": "{isolationDir}" },
      "close": { "processes": [] }
    },
    "linux": {
      "detect": { "command": "gemini" },
      "executable": [{ "kind": "path", "value": "gemini" }],
      "launch": { "args": ["--experimental-acp"] },
      "isolation": { "GEMINI_CLI_HOME": "{isolationDir}" },
      "close": { "processes": [] }
    },
    "macos": {
      "detect": { "command": "gemini" },
      "executable": [{ "kind": "path", "value": "gemini" }],
      "launch": { "args": ["--experimental-acp"] },
      "isolation": { "GEMINI_CLI_HOME": "{isolationDir}" },
      "close": { "processes": [] }
    }
  },
  "auth": { "kind": "oauth-cli", "session": [".gemini/oauth_creds.json"] },
  "models": [{ "id": "default", "name": "Gemini default", "default": true }],
  "capabilities": {
    "approvals": true,
    "hooks": false,
    "checkpoint": false,
    "images": false,
    "planMode": true,
    "resume": true
  }
}
