{
  "id": "claude",
  "schemaVersion": 1,
  "name": "Claude",
  "shortName": "Claude",
  "protocol": "claude-sdk",
  "roots": ["{home}/.claude", "{isolationDir}"],
  "profiles": {
    "windows": {
      "detect": {},
      "update": { "args": ["update"], "latestNpm": "@anthropic-ai/claude-code" },
      "executable": [
        { "kind": "file", "value": "{agentsDir}/claude.exe" },
        { "kind": "file", "value": "{home}/.local/bin/claude.exe" },
        { "kind": "path", "value": "claude" }
      ],
      "install": {
        "format": "binary",
        "version": "2.1.295",
        "url": "https://downloads.claude.ai/claude-code-releases/2.1.295/win32-x64/claude.exe",
        "sha256": "a30012741c3d0b55e2a6c252dab3781134b75be95896ae89d40a93e10f83bcd6",
        "archiveBytes": 259509920,
        "files": [{ "path": "claude.exe", "bytes": 259509920 }],
        "latest": {
          "versionUrl": "https://downloads.claude.ai/claude-code-releases/latest",
          "manifest": "https://downloads.claude.ai/claude-code-releases/{version}/manifest.json",
          "platform": "win32-x64",
          "url": "https://downloads.claude.ai/claude-code-releases/{version}/win32-x64/claude.exe"
        }
      },
      "isolation": { "CLAUDE_CONFIG_DIR": "{isolationDir}" },
      "close": { "processes": ["claude.exe"] }
    },
    "linux": {
      "detect": {},
      "update": { "args": ["update"], "latestNpm": "@anthropic-ai/claude-code" },
      "executable": [{ "kind": "path", "value": "claude" }],
      "isolation": { "CLAUDE_CONFIG_DIR": "{isolationDir}" },
      "close": { "processes": ["claude"] }
    },
    "macos": {
      "detect": {},
      "update": { "args": ["update"], "latestNpm": "@anthropic-ai/claude-code" },
      "executable": [{ "kind": "path", "value": "claude" }],
      "isolation": { "CLAUDE_CONFIG_DIR": "{isolationDir}" },
      "session": [],
      "close": { "processes": ["claude"] }
    }
  },
  "auth": { "kind": "oauth-cli", "session": [".credentials.json"] },
  "login": { "command": ["claude", "auth", "login"] },
  "shared": [
    {
      "variable": "CLAUDE_CONFIG_DIR",
      "paths": ["settings.json", "CLAUDE.md", "skills", "plugins", "agents", "commands", "hooks", "output-styles"]
    }
  ],
  "sharedKeys": [
    { "variable": "CLAUDE_CONFIG_DIR", "path": ".claude.json", "home": "~/.claude.json", "keys": ["mcpServers"] }
  ],
  "hookSources": [
    { "variable": "CLAUDE_CONFIG_DIR", "path": "settings.json", "format": "events" }
  ],
  "models": [],
  "capabilities": {
    "approvals": true,
    "hooks": true,
    "checkpoint": true,
    "images": true,
    "planMode": true,
    "resume": true
  }
}
