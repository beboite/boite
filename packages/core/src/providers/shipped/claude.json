{
  "id": "claude",
  "schemaVersion": 1,
  "name": "Claude",
  "shortName": "Claude",
  "protocol": "claude-sdk",
  "roots": ["{home}/.claude", "{isolationDir}"],
  "profiles": {
    "windows": {
      "detect": {},
      "executable": [
        { "kind": "file", "value": "{home}/.local/bin/claude.exe" },
        { "kind": "path", "value": "claude" }
      ],
      "isolation": { "CLAUDE_CONFIG_DIR": "{isolationDir}" },
      "close": { "processes": ["claude.exe"] }
    },
    "linux": {
      "detect": {},
      "executable": [{ "kind": "path", "value": "claude" }],
      "isolation": { "CLAUDE_CONFIG_DIR": "{isolationDir}" },
      "close": { "processes": ["claude"] }
    },
    "macos": {
      "detect": {},
      "executable": [{ "kind": "path", "value": "claude" }],
      "isolation": { "CLAUDE_CONFIG_DIR": "{isolationDir}" },
      "close": { "processes": ["claude"] }
    }
  },
  "auth": { "kind": "oauth-cli", "session": [".credentials.json"] },
  "models": [
    { "id": "claude-fable-5-1", "name": "Claude Fable 5.1", "badge": "new" },
    { "id": "claude-opus-5", "name": "Claude Opus 5" },
    { "id": "claude-sonnet-5", "name": "Claude Sonnet 5", "default": true },
    { "id": "claude-fable-5", "name": "Claude Fable 5", "legacy": true },
    { "id": "claude-opus-4-8", "name": "Claude Opus 4.8", "legacy": true },
    { "id": "claude-opus-4-7", "name": "Claude Opus 4.7", "legacy": true },
    { "id": "claude-opus-4-6", "name": "Claude Opus 4.6", "legacy": true },
    { "id": "claude-opus-4-5", "name": "Claude Opus 4.5", "legacy": true },
    { "id": "claude-sonnet-4-6", "name": "Claude Sonnet 4.6", "legacy": true },
    { "id": "claude-haiku-4-5-20251001", "name": "Claude Haiku 4.5", "legacy": true }
  ],
  "capabilities": {
    "approvals": true,
    "hooks": true,
    "checkpoint": true,
    "images": true,
    "planMode": true,
    "resume": true
  }
}
