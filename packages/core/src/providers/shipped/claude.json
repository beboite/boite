{
  "id": "claude",
  "schemaVersion": 1,
  "name": "Claude",
  "shortName": "Claude",
  "protocol": "claude-sdk",
  "roots": ["{home}/.claude", "{isolationDir}"],
  "profiles": {
    "windows": {
      "detect": {},
      "executable": [
        { "kind": "file", "value": "{home}/.local/bin/claude.exe" },
        { "kind": "path", "value": "claude" }
      ],
      "isolation": { "CLAUDE_CONFIG_DIR": "{isolationDir}" },
      "close": { "processes": ["claude.exe"] }
    },
    "linux": {
      "detect": {},
      "executable": [{ "kind": "path", "value": "claude" }],
      "isolation": { "CLAUDE_CONFIG_DIR": "{isolationDir}" },
