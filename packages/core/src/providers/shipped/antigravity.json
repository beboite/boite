{
  "id": "antigravity",
  "schemaVersion": 1,
  "name": "Antigravity",
  "shortName": "Antigravity",
  "protocol": "acp",
  "roots": ["{agentsDir}", "{isolationDir}"],
  "profiles": {
    "windows": {
      "detect": { "file": "{agentsDir}/agy_acp_server.exe" },
      "executable": [{ "kind": "file", "value": "{agentsDir}/agy_acp_server.exe" }],
      "launch": { "args": [] },
      "install": {
        "version": "agy_acp_server_1.4.1",
        "arch": "x64",
        "url": "https://dl.google.com/agy-extensions/releases/windows/agy-acp-server-1.4.1-windows-x86_64.zip",
        "sha256": "5f5b7d0328df17c128b2be338d4567b0d24e56ace8196e88794fec37d1372554",
        "archiveBytes": 129599308,
        "files": [
          { "path": "agy_acp_server.exe", "bytes": 86098784 },
          { "path": "localharness_external.exe", "bytes": 146036888 }
        ]
      },
      "isolation": { "GEMINI_HOME": "{isolationDir}" },
      "env": {
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "ANTIGRAVITY_HARNESS_PATH": "{agentsDir}/localharness_external.exe",
        "PYTHONUNBUFFERED": "1",
        "ELECTRON_RUN_AS_NODE": "1",
        "BROWSER": "{browserNoop}"
      },
      "unsetEnv": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "GOOGLE_CLOUD_QUOTA_PROJECT",
        "GOOGLE_GENAI_USE_VERTEXAI",
        "GCLOUD_PROJECT",
        "CLOUDSDK_CORE_PROJECT",
        "AGY_ACP_CCPA_PROJECT",
        "AGY_ACP_ENABLE_OAUTH",
        "GEMINI_HOME",
        "AGY_ACP_FORCE_FILE_STORAGE",
        "ANTIGRAVITY_HARNESS_PATH",
        "BROWSER",
        "PYTHONUNBUFFERED",
        "ELECTRON_RUN_AS_NODE"
      ],
      "close": { "processes": ["agy_acp_server.exe", "localharness_external.exe"] }
    },
    "linux": {
      "detect": { "file": "{agentsDir}/agy_acp_server.par" },
      "executable": [{ "kind": "file", "value": "{agentsDir}/agy_acp_server.par" }],
      "launch": { "args": ["--uid="] },
      "install": {
        "version": "agy_acp_server_1.4.1",
        "arch": "x64",
        "url": "https://dl.google.com/agy-extensions/releases/linux/agy-acp-server-1.4.1-linux-x86_64.zip",
        "sha256": "2e37012ceb2a5c7fc7309b6e6596234fb637ee3c62a5199f65d4cbe777871384",
        "archiveBytes": 336170339,
        "files": [
          { "path": "agy_acp_server.par", "bytes": 930826753 },
          { "path": "localharness_external", "bytes": 131187512, "executable": true }
        ]
      },
      "isolation": { "GEMINI_HOME": "{isolationDir}" },
      "env": {
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "ANTIGRAVITY_HARNESS_PATH": "{agentsDir}/localharness_external",
        "PYTHONUNBUFFERED": "1",
        "ELECTRON_RUN_AS_NODE": "1",
        "BROWSER": "{browserNoop}"
      },
      "unsetEnv": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "GOOGLE_CLOUD_QUOTA_PROJECT",
        "GOOGLE_GENAI_USE_VERTEXAI",
        "GCLOUD_PROJECT",
        "CLOUDSDK_CORE_PROJECT",
        "AGY_ACP_CCPA_PROJECT",
        "AGY_ACP_ENABLE_OAUTH",
        "GEMINI_HOME",
        "AGY_ACP_FORCE_FILE_STORAGE",
        "ANTIGRAVITY_HARNESS_PATH",
        "BROWSER",
        "PYTHONUNBUFFERED",
        "ELECTRON_RUN_AS_NODE"
      ],
      "close": { "processes": ["agy_acp_server.par", "localharness_external"] }
    },
    "macos": {
      "detect": { "file": "{agentsDir}/agy_acp_server.par" },
      "executable": [{ "kind": "file", "value": "{agentsDir}/agy_acp_server.par" }],
      "launch": { "args": [] },
      "install": {
        "version": "agy_acp_server_1.4.1",
        "arch": "arm64",
        "url": "https://dl.google.com/agy-extensions/releases/macos/agy-acp-server-1.4.1-darwin-arm64.zip",
        "sha256": "f9bdd68291ae78c38d2141e63bc86b84e6cc7b9f60f71652c68435a7943deb17",
        "archiveBytes": 112737434,
        "files": [
          { "path": "agy_acp_server.par", "bytes": 280996576 },
          { "path": "localharness_external", "bytes": 120246928, "executable": true }
        ]
      },
      "isolation": { "GEMINI_HOME": "{isolationDir}" },
      "env": {
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "ANTIGRAVITY_HARNESS_PATH": "{agentsDir}/localharness_external",
        "PYTHONUNBUFFERED": "1",
        "ELECTRON_RUN_AS_NODE": "1",
        "BROWSER": "{browserNoop}"
      },
      "unsetEnv": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "GOOGLE_CLOUD_QUOTA_PROJECT",
        "GOOGLE_GENAI_USE_VERTEXAI",
        "GCLOUD_PROJECT",
        "CLOUDSDK_CORE_PROJECT",
        "AGY_ACP_CCPA_PROJECT",
        "AGY_ACP_ENABLE_OAUTH",
        "GEMINI_HOME",
        "AGY_ACP_FORCE_FILE_STORAGE",
        "ANTIGRAVITY_HARNESS_PATH",
        "BROWSER",
        "PYTHONUNBUFFERED",
        "ELECTRON_RUN_AS_NODE"
      ],
      "close": { "processes": ["agy_acp_server.par", "localharness_external"] }
    }
  },
  "auth": { "kind": "oauth-cli", "session": ["antigravity-acp/acp_token.json"] },
  "login": { "acp": { "methodId": "oauth-personal" } },
  "isolation": { "alwaysIsolated": true },
  "seedFiles": { "antigravity-acp/settings.json": "{\"auth\":{\"type\":\"oauth-personal\"}}" },
  "shared": [{ "variable": "GEMINI_HOME", "paths": ["config/skills", "antigravity-cli/skills"] }],
  "quirks": ["antigravity"],
  "models": [{ "id": "default", "name": "Antigravity default", "default": true }],
  "capabilities": {
    "approvals": true,
    "hooks": false,
    "checkpoint": false,
    "images": true,
    "planMode": false,
    "resume": true
  }
}
