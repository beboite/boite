{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The local main UI may invoke shell commands and use its window controls, dialogs and external links. Browser child webviews and remote origins receive no permissions.",
  "webviews": ["main"],
  "permissions": [
    "allow-shell",
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-open",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "http://*" }, { "url": "https://*" }] },
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**/keybindings.json" }] }
  ]
}
