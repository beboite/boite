#!/usr/bin/env bash
# Container entrypoint: boot a headful stealth chromium (for chrome-devtools-axi)
# in the background, then hand off to boite-server as PID 1's child. Browser
# startup is best-effort and must never block the server, so everything before
# the exec swallows its own failures.
export DISPLAY=:99

(
  set +e
  if ! pgrep -x Xvfb >/dev/null 2>&1; then
    Xvfb :99 -screen 0 1280x800x24 -nolisten tcp >/tmp/xvfb.log 2>&1 &
    sleep 1
  fi
  stealth-chromium >/tmp/chromium.log 2>&1 &
) || true

exec boite-server
