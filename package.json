{
  "name": "boite",
  "version": "1.3.4",
  "description": "Lightweight multi-agent terminal multiplexer",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && oxlint && node scripts/i18n-unused.mjs && node scripts/text-opacity.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "tauri": "tauri",
    "build:sidecar": "bun scripts/build-sidecar.mjs",
    "dev:isolated": "tauri dev --config src-tauri/tauri.dev-isolated.conf.json --features mcp-bridge",
    "typecheck:fast": "tsgo --noEmit",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "budget": "node scripts/bundle-budget.mjs"
  },
  "license": "MIT",
  "//overrides": "Every @codemirror/lang-* package depends on @codemirror/state, view and autocomplete with its own range, and bumping only the three top-level ones left two copies of each in the tree. Every lazily loaded grammar chunk then carried its own copy: 1516 KB of extra shipped bytes for nothing, which is what took `bun run budget` over its ceiling. CodeMirror packages are documented as needing exactly one copy of state and view at runtime, so this is not only about size.",
  "overrides": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@codemirror/autocomplete": "6.20.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lucide/svelte": "^1.33.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "2.4.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "2.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "pdfjs-dist": "^6.2.108",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "beta",
    "oxlint": "^1.79.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
